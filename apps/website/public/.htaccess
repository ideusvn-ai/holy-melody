# Holy Melody — Apache / shared hosting (cPanel, DirectAdmin…)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # giữ header đăng nhập (Bearer) khi PHP chạy dạng CGI/FastCGI
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # bắt buộc HTTPS (bỏ 4 dòng này nếu hosting tự chuyển HTTPS hoặc chưa có SSL)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # mọi đường dẫn không phải file tĩnh → index.php (website + /api/*)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(env|sql|md|log|json|lock|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
