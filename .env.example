# ===== Holy Melody backend — sao chép thành backend/.env (KHÔNG commit file .env) =====
HM_PUBLIC_URL=https://holymelody.app
HM_CORS_ORIGINS=https://holymelody.app,tauri://localhost,http://tauri.localhost

# MySQL 8.0+ / MariaDB 10.6+ (cần SKIP LOCKED)
HM_DB_HOST=127.0.0.1
HM_DB_PORT=3306
HM_DB_NAME=holymelody
HM_DB_USER=holymelody
HM_DB_PASS=

# Google: client ID của Web và Desktop (ngăn cách bằng dấu phẩy) — dùng để kiểm tra `aud`
HM_GOOGLE_CLIENT_IDS=


# Thanh toán SePay (chuyển khoản VietQR + webhook) — my.sepay.vn
# HM_SEPAY_BANK: mã ngắn ngân hàng theo qr.sepay.vn/banks.json (vd MBBank, Vietcombank, ACB, TPBank…)
HM_SEPAY_BANK=
HM_SEPAY_ACCOUNT_NUMBER=
HM_SEPAY_ACCOUNT_NAME=
# Xác thực webhook: HMAC-SHA256 (khuyên dùng) HOẶC API Key — điền đúng loại đã chọn khi tạo webhook
HM_SEPAY_WEBHOOK_SECRET=
HM_SEPAY_API_KEY=
# Tiền tố mã thanh toán — trùng với cấu hình "Cấu trúc mã thanh toán" trên my.sepay.vn (tiền tố HM, hậu tố 10 chữ số)
HM_SEPAY_CODE_PREFIX=HM

# Token chia sẻ giữa API và AI worker (chuỗi ngẫu nhiên ≥ 32 ký tự)
HM_WORKER_TOKEN=

# Loại AI đã có worker/provider thật (vd: harmony,singer). Để trống = tắt hết AI, không nhận job.
HM_AI_ENABLED_TYPES=
HM_STORAGE_DIR=/var/holymelody/storage

# Chỉ dùng cho test tích hợp (CSDL riêng, sẽ bị xóa dữ liệu!)
# HM_TEST_DB_HOST=127.0.0.1
# HM_TEST_DB_NAME=holymelody_test
# HM_TEST_DB_USER=root
# HM_TEST_DB_PASS=

# AI đọc lại vùng nhận dạng khó khi chuyển sang Editor (để trống = tắt)
# OpenAI (máy chủ giữ key; app không bao giờ thấy key):
#  - Chuyển sang Editor: rà soát từng dòng nhạc + đọc lời ca tiếng Việt (Responses API, ảnh + văn bản)
#  - AI Singer: giọng đọc từng âm tiết (TTS), app tự chỉnh cao độ theo nốt
HM_OPENAI_API_KEY=
HM_OPENAI_MODEL=gpt-5.6-sol
HM_OPENAI_TTS_MODEL=gpt-4o-mini-tts
HM_OPENAI_TTS_VOICE=coral
# số lượt AI tối đa cho mỗi bản nhạc đã chuyển sang Editor (admin không giới hạn)
HM_AI_OMR_MAX_CALLS=60
# thư mục lưu đệm âm tiết AI Singer (mặc định thư mục tạm)
HM_STORAGE_DIR=
